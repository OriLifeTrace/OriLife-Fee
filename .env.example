# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Only the bridge layer needs these — the core layer (feeEngine, bridge, buckets, tasks)
# runs with no configuration at all.

# Blockfrost project id for the network below.
BLOCKFROST_KEY=

# Mnemonic of the wallet that pays fees and signs. Test wallet only.
WALLET_SEED=

# LAMP asset identity on that network.
LAMP_POLICY_ID=
LAMP_ASSET_NAME=4c414d50

# Cardano network. Defaults to Preview when unset.
NETWORK=Preview
