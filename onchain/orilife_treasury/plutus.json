    "orilife/types/EscrowDatum": {
      "title": "EscrowDatum",
      "description": "Kho tạm giữ phần đã trích. Tiền ở đây chỉ có một lối ra: một giao dịch có nộp\n kho bạc Cardano.",
      "anyOf": [
        {
          "title": "EscrowDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "carp",
              "description": "Số CARP mà UTxO này đang giữ. Khai tường minh để người đọc không phải suy từ\n giá trị kèm theo, và để hợp đồng bắt được trường hợp khai lệch.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "vault",
              "description": "Băm hợp đồng kho phí đã trích khoản này ra.\n\n Vì sao cần: `list.length(own_inputs) == 1` bên kho phí chỉ đếm input CÙNG băm\n script. Hai instance kho phí khác tham số có băm khác nhau, nên mỗi cái tự thấy\n mình là input duy nhất, và MỘT output ở kho tạm thoả điều kiện cho CẢ HAI — hai\n lần `skimmed` tăng mà chỉ một lần CARP rời kho. Ràng khoản trích vào đúng một băm\n kho phí là chỗ chặn việc đó.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "parent",
              "description": "Ô đầu vào mà UTxO này là phần dư của. `None` nghĩa là khoản vừa được trích sang,\n chưa từng bị tiêu.\n\n Vì sao cần: kho tạm đo phần đã rời đi bằng `giữ − trả_lại`, và trước đây `trả_lại`\n là TỔNG mọi output ở địa chỉ mình. Bộ lọc đó không phân biệt phần dư của chính\n mình với tiền MỚI vừa được gửi vào trong cùng giao dịch, nên ghép `Skim` và\n `Donate` vào một giao dịch là `trả_lại` phình lên và nghĩa vụ bốc hơi. Có trường\n này thì phần dư tự khai mình là phần dư của ô nào.",
              "$ref": "#/definitions/Option<cardano~1transaction~1OutputReference>"
            }
          ]
        }
      ]
    },
    "orilife/types/EscrowRedeemer": {
      "title": "EscrowRedeemer",
      "anyOf": [
        {
          "title": "Donate",
          "description": "Đổi CARP lấy ADA rồi nộp kho bạc. Ai cũng gọi được — cố ý: nếu OriLife biến mất\n thì lời hứa vẫn thực thi được bởi người ngoài.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        }
      ]
    },
    "orilife/types/VaultDatum": {
      "title": "VaultDatum",
      "description": "Trạng thái kho phí. Hai con số này là toàn bộ lời khai của kho, và ai cũng đọc được\n chúng trực tiếp từ UTxO — không phải hỏi máy chủ nào.\n\n `collected` chỉ tăng, `skimmed` chỉ tăng, và `skimmed` không bao giờ vượt phần\n nghĩa vụ tính trên `collected`. Ba câu đó là toàn bộ cơ chế bảo đảm lời hứa 10%.",
      "anyOf": [
        {
          "title": "VaultDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "collected",
              "description": "Tổng CARP đã từng chảy vào kho, cộng dồn từ đầu. KHÔNG phải số dư hiện tại.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "skimmed",
              "description": "Tổng CARP đã chuyển sang kho tạm chờ đổi ADA. Cũng cộng dồn.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "orilife/types/VaultRedeemer": {
      "title": "VaultRedeemer",
      "anyOf": [
        {
          "title": "Collect",
          "description": "Nộp phí vào kho. Ai cũng gọi được — kho không cần biết người nộp là ai, nó chỉ\n cần giá trị vào đúng bằng con số khai trong `amount`.",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "amount",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Skim",
          "description": "Trích phần nghĩa vụ sang kho tạm. Không được trích quá phần nghĩa vụ.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "amount",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Operate",
          "description": "Chi tiêu phần vận hành. Đây là chỗ DUY NHẤT tiền rời kho mà không sang kho tạm,\n nên đây cũng là chỗ duy nhất cần chặn.",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        },
        {
          "title": "Close",
          "description": "Đóng kho. Chỉ được khi nghĩa vụ đã trả hết; sau đó UTxO kho không còn tồn tại.\n\n Vì sao phải có: không có nó thì ADA giữ chỗ nằm lại vĩnh viễn (mọi nhánh khác đều\n ép `lovelace_of(ra) >= lovelace_of(vào)`, tức ADA chỉ có đường vào), và `operator_key`\n là tham số biên dịch nên xoay khoá vận hành là phải dựng instance mới — mà instance\n cũ thì không đóng lại được. Đóng được kho là điều kiện để xoay khoá mà không bỏ của.",
          "dataType": "constructor",
          "index": 3,
          "fields": []
        }
      ]
    }
  }
}